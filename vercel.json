{
  "version": 2,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/api/assets/$1"
    },
    {
      "src": "/login.php",
      "dest": "/api/login.php"
    },
    {
      "src": "/register.php",
      "dest": "/api/register.php"
    },
    {
      "src": "/views/(.*)",
      "dest": "/api/views/$1"
    },
    {
      "src": "/proses/(.*)",
      "dest": "/api/proses/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}