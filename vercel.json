{
  "version": 2,
  "builds": [
    {
      "src": "views/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "proses/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.php",
      "use": "vercel-php@0.5.2"
    }
  ],
  "routes": [
    {
      "src": "/views/(.*)",
      "dest": "/views/$1"
    },
    {
      "src": "/proses/(.*)",
      "dest": "/proses/$1"
    },
    {
      "src": "/$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}