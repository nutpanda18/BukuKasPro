{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "api/views/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "api/proses/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "api/config/*.php",
      "use": "vercel-php@0.5.2"
    }
  ]
}