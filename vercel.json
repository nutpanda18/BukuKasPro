{
  "version": 2,
  "builds": [
    {
      "src": "views/**/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "proses/**/*.php",
      "use": "vercel-php@0.5.2"
    },
    {
      "src": "*.php",
      "use": "vercel-php@0.5.2"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}